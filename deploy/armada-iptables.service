[Unit]
Description=Armada demo DNAT rules (kind-armada-server NodePorts)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /root/armada/deploy/apply-iptables.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
